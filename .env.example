# Runtime
NODE_ENV=development
PORT=5000
PUBLIC_APP_URL=http://localhost:5000
AUTH_ALLOWED_ORIGINS=http://localhost:5000
PASSWORD_RESET_REDIRECT_URL=http://localhost:5000/reset-password

# Supabase client-safe values. These may be present in the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
VITE_AUTH_MODE=demo

# Server-only Supabase values. Never prefix a secret key with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Database and cryptographic secrets. Use independent values per environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SESSION_SECRET=replace-with-at-least-32-random-characters
APPROVAL_TOKEN_SECRET=replace-with-a-different-32-character-secret

# Demonstration authentication is development-only and must be disabled in production.
DEMO_AUTH_ENABLED=true
DEMO_COMPANY_CODE=itt001
DEMO_EMAIL=desmond.bale@islandtraveltech.com
DEMO_PASSWORD=replace-with-a-local-demo-password
DEMO_PASSWORD_HASH=replace-with-a-bcrypt-hash-generated-outside-source-control
LEGACY_API_ENABLED=false

# MFA policy foundation. Privileged roles must reach AAL2 before pilot launch.
MFA_REQUIRED_ROLES=coordinator,approver,manager,finance_admin,travel_admin,super_admin

# Legacy runtime compatibility during the controlled migration. These remain
# server-only and will be retired as their B2/B3 replacements are implemented.
ISSUER_URL=https://replit.com/oidc
REPL_ID=replace-with-local-application-id
DEFAULT_OBJECT_STORAGE_BUCKET_ID=replace-with-local-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=public
PRIVATE_OBJECT_DIR=private

# Optional external integrations. Keep unset when the feature is not used.
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
SENDGRID_API_KEY=
